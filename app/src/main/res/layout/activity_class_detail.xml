<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar_class_detail"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:menu="@menu/menu_class_detail"
            app:title="Chi tiết lớp học"
            app:titleTextAppearance="@style/TextAppearance.Material3.TitleMedium"
            app:titleTextColor="@color/text_primary" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />
    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Header Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_lg"
            android:layout_marginTop="@dimen/spacing_md"
            android:layout_marginEnd="@dimen/spacing_lg"
            android:layout_marginBottom="@dimen/spacing_sm"
            app:cardCornerRadius="@dimen/corner_md"
            app:cardElevation="1dp"
            app:strokeColor="@color/divider"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_lg">

                <TextView
                    android:id="@+id/tv_detail_class_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_headline"
                    android:textStyle="bold"
                    tools:text="Lập trình Di động 1" />

                <TextView
                    android:id="@+id/tv_detail_class_code"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/primary"
                    android:textSize="@dimen/text_body_lg"
                    android:textStyle="bold"
                    tools:text="IT4010 - Nhóm 01" />

                <TextView
                    android:id="@+id/tv_detail_class_note"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_body_sm"
                    tools:text="Phòng B1-302 • Thứ Sáu (08:00 - 11:30)" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_detail_student_count"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_body"
                        android:textStyle="bold"
                        tools:text="8 sinh viên" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_detail_create_session"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/min_touch_target"
                        android:text="@string/class_detail_btn_new_session"
                        android:textColor="@color/white"
                        app:cornerRadius="@dimen/corner_md"
                        app:icon="@drawable/ic_add"
                        app:iconTint="@color/white" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_detail_add_student"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/min_touch_target"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:text="@string/class_detail_btn_add_student"
                        android:textColor="@color/primary"
                        app:cornerRadius="@dimen/corner_md" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Search Bar -->
        <EditText
            android:id="@+id/et_student_search"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginStart="@dimen/spacing_lg"
            android:layout_marginTop="@dimen/spacing_xs"
            android:layout_marginEnd="@dimen/spacing_lg"
            android:layout_marginBottom="@dimen/spacing_xs"
            android:background="@drawable/bg_search_bar"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="@dimen/spacing_sm"
            android:hint="@string/class_detail_search_student_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:paddingStart="@dimen/spacing_md"
            android:paddingEnd="@dimen/spacing_md"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_tertiary"
            android:textSize="@dimen/text_body" />

        <!-- Empty Student State -->
        <LinearLayout
            android:id="@+id/ll_students_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/spacing_xxl"
            android:visibility="gone"
            tools:visibility="gone">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_person"
                app:tint="@color/text_tertiary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:text="@string/class_detail_empty_students_title"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_title"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:gravity="center"
                android:text="@string/class_detail_empty_students_desc"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_body" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_empty_add_student"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/min_touch_target"
                    android:text="@string/class_detail_btn_add_student"
                    android:textColor="@color/white"
                    app:cornerRadius="@dimen/corner_md"
                    app:icon="@drawable/ic_add"
                    app:iconTint="@color/white" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_empty_import_csv"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/min_touch_target"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:text="Nhập CSV"
                    android:textColor="@color/primary"
                    app:cornerRadius="@dimen/corner_md"
                    app:icon="@drawable/ic_file_upload"
                    app:iconTint="@color/primary" />
            </LinearLayout>
        </LinearLayout>

        <!-- Students RecyclerView -->
        <TextView android:id="@+id/tv_student_search_empty" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:padding="24dp" android:gravity="center"
            android:text="Không tìm thấy sinh viên" android:textColor="@color/text_secondary" android:visibility="gone" />
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_class_students"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="@dimen/spacing_xs"
            android:paddingBottom="@dimen/spacing_xl"
            tools:itemCount="5"
            tools:listitem="@layout/item_student" />

    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
