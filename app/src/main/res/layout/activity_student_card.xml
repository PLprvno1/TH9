<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/background">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar_card" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize" android:title="Thẻ sinh viên điện tử" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
            <TextView android:id="@+id/card_state" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Đang tải thẻ…" android:padding="12dp" />
            <com.example.th9.view.StudentCardView android:id="@+id/student_card" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <com.google.android.material.button.MaterialButton android:id="@+id/card_save" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Lưu ảnh thẻ" />
            <com.google.android.material.button.MaterialButton android:id="@+id/card_share" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Chia sẻ thẻ" />
            <com.google.android.material.button.MaterialButton android:id="@+id/card_verify" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Quét kiểm tra" />
            <com.google.android.material.button.MaterialButton android:id="@+id/card_edit" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Chỉnh sửa hồ sơ" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
