<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/background">
<com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar_schedule_form" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize" app:title="@string/schedule_add" app:navigationIcon="@drawable/ic_arrow_back" />
<androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="match_parent"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/schedule_class" android:textColor="@color/text_secondary" />
<Spinner android:id="@+id/schedule_form_class" android:layout_width="match_parent" android:layout_height="56dp" android:contentDescription="@string/schedule_class" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/schedule_shift" android:textColor="@color/text_secondary" />
<RadioGroup android:id="@+id/schedule_form_shift" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
<com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/shift_morning" android:layout_width="wrap_content" android:layout_height="48dp" android:text="Sáng" android:checked="true" />
<com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/shift_afternoon" android:layout_width="wrap_content" android:layout_height="48dp" android:text="Chiều" />
</RadioGroup>
<com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="@string/schedule_from"><com.google.android.material.textfield.TextInputEditText android:id="@+id/schedule_form_from" android:layout_width="match_parent" android:layout_height="wrap_content" android:focusable="false" android:clickable="true" android:inputType="none" /></com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="@string/schedule_until"><com.google.android.material.textfield.TextInputEditText android:id="@+id/schedule_form_until" android:layout_width="match_parent" android:layout_height="wrap_content" android:focusable="false" android:clickable="true" android:inputType="none" /></com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="@string/schedule_start"><com.google.android.material.textfield.TextInputEditText android:id="@+id/schedule_form_start" android:layout_width="match_parent" android:layout_height="wrap_content" android:focusable="false" android:clickable="true" android:inputType="none" /></com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="@string/schedule_end"><com.google.android.material.textfield.TextInputEditText android:id="@+id/schedule_form_end" android:layout_width="match_parent" android:layout_height="wrap_content" android:focusable="false" android:clickable="true" android:inputType="none" /></com.google.android.material.textfield.TextInputLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/schedule_days" android:textStyle="bold" android:textColor="@color/text_primary" />
<com.google.android.material.chip.ChipGroup android:id="@+id/schedule_form_days" android:layout_width="match_parent" android:layout_height="wrap_content" app:singleSelection="false">
<com.google.android.material.chip.Chip android:id="@+id/schedule_day_0" style="@style/Widget.MaterialComponents.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="T2" android:checkable="true" />
<com.google.android.material.chip.Chip android:id="@+id/schedule_day_1" style="@style/Widget.MaterialComponents.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="T3" android:checkable="true" />
<com.google.android.material.chip.Chip android:id="@+id/schedule_day_2" style="@style/Widget.MaterialComponents.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="T4" android:checkable="true" />
<com.google.android.material.chip.Chip android:id="@+id/schedule_day_3" style="@style/Widget.MaterialComponents.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="T5" android:checkable="true" />
<com.google.android.material.chip.Chip android:id="@+id/schedule_day_4" style="@style/Widget.MaterialComponents.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="T6" android:checkable="true" />
<com.google.android.material.chip.Chip android:id="@+id/schedule_day_5" style="@style/Widget.MaterialComponents.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="T7" android:checkable="true" />
<com.google.android.material.chip.Chip android:id="@+id/schedule_day_6" style="@style/Widget.MaterialComponents.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CN" android:checkable="true" />
</com.google.android.material.chip.ChipGroup>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/schedule_hint" android:textColor="@color/text_secondary" android:lineSpacingExtra="4dp" />
<TextView android:id="@+id/schedule_form_error" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="12dp" android:textColor="@color/status_absent" android:accessibilityLiveRegion="polite" />
<com.google.android.material.button.MaterialButton android:id="@+id/schedule_form_save" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/schedule_save" />
</LinearLayout></androidx.core.widget.NestedScrollView></LinearLayout>
