<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/background">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar_accounts" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="16dp" android:paddingTop="8dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/teachers_directory" android:textColor="@color/text_primary" android:textSize="20sp" android:textStyle="bold" />
            <com.google.android.material.button.MaterialButton android:id="@+id/accounts_add" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/teachers_add" app:icon="@drawable/ic_add" />
        </LinearLayout>
        <TextView android:id="@+id/accounts_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:textColor="@color/text_secondary" android:textSize="14sp" />
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/teachers_search" app:startIconDrawable="@drawable/ic_search" app:endIconMode="clear_text">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/accounts_search" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:imeOptions="actionSearch" android:maxLines="1" android:maxLength="160" />
        </com.google.android.material.textfield.TextInputLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginVertical="8dp" android:gravity="center_vertical">
            <TextView android:id="@+id/accounts_results" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/text_secondary" android:textSize="13sp" android:accessibilityLiveRegion="polite" />
            <com.google.android.material.button.MaterialButton android:id="@+id/accounts_sort" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="wrap_content" app:icon="@drawable/ic_sort" android:contentDescription="@string/teachers_sort" />
        </LinearLayout>
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/accounts_list" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:paddingBottom="16dp" />
        <LinearLayout android:id="@+id/accounts_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="28dp" android:visibility="gone">
            <ImageView android:layout_width="56dp" android:layout_height="56dp" android:src="@drawable/ic_person" app:tint="@color/primary" android:importantForAccessibility="no" />
            <TextView android:id="@+id/accounts_empty_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:gravity="center" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/text_primary" />
            <TextView android:id="@+id/accounts_empty_description" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:textColor="@color/text_secondary" />
            <com.google.android.material.button.MaterialButton android:id="@+id/accounts_clear_search" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/teachers_clear_search" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
