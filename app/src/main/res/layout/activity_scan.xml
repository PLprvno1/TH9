<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0F19">

    <!-- Top Overlay Controls -->
    <LinearLayout
        android:id="@+id/ll_scan_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#80000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_lg"
        android:paddingTop="36dp"
        android:paddingEnd="@dimen/spacing_lg"
        android:paddingBottom="@dimen/spacing_md">

        <ImageButton
            android:id="@+id/btn_scan_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_back"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/white" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_md"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_scan_header_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="@dimen/text_body_lg"
                android:textStyle="bold"
                tools:text="Buổi 05: Điểm danh tuần 5" />

            <TextView
                android:id="@+id/tv_scan_header_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#94A3B8"
                android:textSize="@dimen/text_caption"
                tools:text="Lập trình Di động 1 • Tiến độ: 5/8" />
        </LinearLayout>

        <!-- Flashlight Toggle -->
        <ImageButton
            android:id="@+id/btn_scan_flash"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Đèn pin"
            android:src="@drawable/ic_flash_off" />

    </LinearLayout>

    <!-- Center Camera Preview & 1D Barcode Reticle -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="80dp"
        android:layout_marginBottom="180dp">

        <!-- Camera preview -->
        <androidx.camera.view.PreviewView
            android:id="@+id/camera_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:implementationMode="compatible" />

        <!-- Camera Unavailable Overlay (State 6) -->
        <LinearLayout
            android:id="@+id/ll_camera_error_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#E60B0F19"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/spacing_xl"
            android:visibility="gone"
            tools:visibility="gone">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_cancel"
                app:tint="@color/status_absent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:id="@+id/tv_camera_error"
                android:text="Camera không khả dụng"
                android:textColor="@color/white"
                android:textSize="@dimen/text_title"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:gravity="center"
                android:text="Kiểm tra quyền camera hoặc dùng điểm danh thủ công."
                android:textColor="#94A3B8"
                android:textSize="@dimen/text_body" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_fallback_manual"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/min_touch_target"
                android:layout_marginTop="@dimen/spacing_lg"
                android:text="Điểm danh bằng MSSV"
                android:textColor="@color/white"
                app:cornerRadius="@dimen/corner_md" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_camera_retry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thử lại" />
        </LinearLayout>

        <!-- 1D Horizontal Reticle Frame (Target Box) -->
        <FrameLayout
            android:id="@+id/fl_reticle_frame"
            android:layout_width="300dp"
            android:layout_height="110dp"
            android:layout_centerInParent="true"
            android:background="@drawable/bg_scanner_reticle">

            <!-- Red Laser Line -->
            <View
                android:id="@+id/view_laser_line"
                android:layout_width="match_parent"
                android:layout_height="2.5dp"
                android:layout_gravity="center_vertical"
                android:background="#EF4444" />
        </FrameLayout>

        <!-- Aim Instruction Text -->
        <TextView
            android:id="@+id/tv_scan_instruction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/fl_reticle_frame"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="@dimen/spacing_lg"
            android:background="#80000000"
            android:paddingStart="@dimen/spacing_md"
            android:paddingTop="@dimen/spacing_xs"
            android:paddingEnd="@dimen/spacing_md"
            android:paddingBottom="@dimen/spacing_xs"
            android:text="@string/scan_aim_instruction"
            android:textColor="@color/white"
            android:textSize="@dimen/text_body_sm" />

    </RelativeLayout>

    <!-- Bottom Result & Simulation Controls Panel -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#1E293B"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_lg"
        android:paddingTop="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_lg"
        android:paddingBottom="@dimen/spacing_xl">

        <!-- Result Card Popup (Animated) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_scan_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#0F172A"
            app:cardCornerRadius="@dimen/corner_md"
            app:cardElevation="2dp"
            app:strokeColor="#334155"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_md">

                <ImageView
                    android:id="@+id/iv_result_icon"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_barcode"
                    app:tint="@color/status_present" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_md"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_result_status_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/scan_state_waiting"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_body_lg"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_result_student_info"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Hướng camera vào mã vạch trên thẻ sinh viên"
                        android:textColor="#94A3B8"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_result_time_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#60A5FA"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="08:24:30" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Main Scanner Action Buttons -->
        <LinearLayout
            android:id="@+id/ll_scan_actions_attendance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_finish_scan"
                android:layout_width="0dp"
                android:layout_height="@dimen/min_touch_target"
                android:layout_marginEnd="@dimen/spacing_xs"
                android:layout_weight="1"
                android:backgroundTint="@color/primary"
                android:text="Kết thúc buổi"
                android:textColor="@color/white"
                android:textStyle="bold"
                app:cornerRadius="@dimen/corner_md"
                app:icon="@drawable/ic_qr_scan"
                app:iconTint="@color/white" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_scan_manual_input"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/min_touch_target"
                android:layout_marginStart="@dimen/spacing_xs"
                android:layout_weight="1"
                android:text="@string/scan_btn_manual"
                android:textColor="@color/white"
                app:cornerRadius="@dimen/corner_md"
                app:icon="@drawable/ic_edit"
                app:iconTint="@color/white" />
        </LinearLayout>

        <!-- Link Card Mode Actions -->
        <LinearLayout
            android:id="@+id/ll_scan_actions_link"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_link_rescan"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/min_touch_target"
                android:layout_marginEnd="@dimen/spacing_xs"
                android:layout_weight="1"
                android:text="Quét lại"
                android:textColor="@color/white"
                app:cornerRadius="@dimen/corner_md"
                app:strokeColor="#64748B" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_link_confirm"
                android:layout_width="0dp"
                android:layout_height="@dimen/min_touch_target"
                android:layout_marginStart="@dimen/spacing_xs"
                android:layout_weight="1"
                android:backgroundTint="@color/status_present"
                android:text="Xác nhận gắn mã"
                android:textColor="@color/white"
                android:textStyle="bold"
                app:cornerRadius="@dimen/corner_md" />
        </LinearLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
