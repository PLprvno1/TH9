<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="24dp" android:paddingTop="4dp">
    <TextView android:id="@+id/class_teachers_class" android:layout_width="match_parent" android:layout_height="wrap_content" android:textStyle="bold" android:textColor="@color/text_primary" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/class_teachers_hint" android:textColor="@color/text_secondary" />
    <EditText android:id="@+id/class_teachers_search" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="12dp" android:background="@drawable/bg_search_bar" android:drawableStart="@drawable/ic_search" android:drawablePadding="8dp" android:paddingHorizontal="12dp" android:singleLine="true" android:inputType="text" android:imeOptions="actionSearch" android:hint="@string/class_teachers_search" android:textSize="14sp" />
    <TextView android:id="@+id/class_teachers_count" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="8dp" android:textColor="@color/text_secondary" android:accessibilityLiveRegion="polite" />
    <ListView android:id="@+id/class_teachers_list" android:layout_width="match_parent" android:layout_height="220dp" android:choiceMode="singleChoice" android:divider="@null" />
    <Button android:id="@+id/class_teachers_clear" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/class_teachers_clear" />
    <TextView android:id="@+id/class_teachers_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:text="@string/class_teachers_empty" android:textColor="@color/text_secondary" android:visibility="gone" />
    <TextView android:id="@+id/class_teachers_error" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/status_absent" android:accessibilityLiveRegion="polite" />
</LinearLayout>
