    <com.google.android.material.button.MaterialButton android:id="@+id/home_suggestions_extra" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_extra_session" />
